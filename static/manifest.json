{
  "manifest_version": 3,
  "name": "Advanced Tab Manager",
  "version": "0.1.0",
  "description": "Search, collect, and manage tabs across Chromium windows.",
  "minimum_chrome_version": "127",
  "permissions": ["tabs", "storage", "sessions", "downloads", "topSites", "favicon"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Advanced Tab Manager", "default_popup": "popup.html" },
  "commands": { "open-tab-manager": { "suggested_key": { "default": "Alt+Shift+A" }, "description": "Open Advanced Tab Manager" } }
}
